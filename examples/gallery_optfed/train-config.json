{
  "data": {
    "prepared": "prepared",
    "targets": [
      "biomass",
      "glycerol",
      "product"
    ],
    "target_source": "reactor_components"
  },
  "custom_py": "custom.py",
  "train": {
    "epochs": 500,
    "seed": 0,
    "learning_rate": 0.01,
    "grad_clip_norm": 0.05,
    "allow_stateful_models": true,
    "batch_size": 1,
    "shuffle": false
  },
  "solver": {
    "max_steps": 100000,
    "rtol": 1e-05,
    "atol": 1e-07
  },
  "checkpoint": {
    "every": 0
  },
  "output": {
    "dir": "run",
    "predictions": "parents"
  }
}
